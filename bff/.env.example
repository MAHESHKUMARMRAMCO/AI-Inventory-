PORT=4000

# Backend (internal) base URL and shared secret — must match the backend's INTERNAL_SHARED_SECRET
BACKEND_BASE_URL=http://localhost:4001
INTERNAL_SHARED_SECRET=change-this-shared-secret

# Browser origin allowed to call this BFF cross-origin (the frontend dev server / host)
FRONTEND_ORIGIN=http://localhost:3000

# Redis (rate limiting + order-lookup response cache)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Rate limiting: max requests per IP per window
RATE_LIMIT_POINTS=20
RATE_LIMIT_DURATION_SECONDS=1

# Cache TTL for a successful (Released/Blocked) order lookup result
ORDER_CACHE_TTL_SECONDS=300
